{
  "name": "private-profile",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "check:dashes": "scripts/check-dashes.sh",
    "check": "pnpm check:dashes && pnpm build && pnpm test"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
