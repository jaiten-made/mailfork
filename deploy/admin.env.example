# Copy to /etc/mailfork/admin.env on the server and fill in. Not secret,
# but keep it out of git with the rest. The Cloudflare API token, the tunnel
# token, the restic password and the R2 key pair go in their own files next
# to it (see docs/deployment.md).

# The Profile Domain, such as profile.example.
PROFILE_DOMAIN=

# The Access team domain, such as owner.cloudflareaccess.com (no https://).
ACCESS_TEAM_DOMAIN=

# The Access application's Application Audience (AUD) tag.
ACCESS_AUD=

# Where the address list publisher writes (docs/kv-address-list.md).
CLOUDFLARE_ACCOUNT_ID=
KV_NAMESPACE_ID=

# The restic repository for Backups (docs/adr/0003), such as
# s3:https://<account id>.r2.cloudflarestorage.com/mailfork-backups
RESTIC_REPOSITORY=
