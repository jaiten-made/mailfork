# Copy to /etc/private-profile/admin.env on the Pi and fill in. Not secret,
# but keep it out of git with the rest. The Cloudflare API token and the
# tunnel token go in their own files next to it (see docs/pi-deployment.md).

# The Profile Domain, such as profile.example.
PROFILE_DOMAIN=

# The Access team domain, such as owner.cloudflareaccess.com (no https://).
ACCESS_TEAM_DOMAIN=

# The Access application's Application Audience (AUD) tag.
ACCESS_AUD=

# Where the address list publisher writes (docs/kv-address-list.md).
CLOUDFLARE_ACCOUNT_ID=
KV_NAMESPACE_ID=
