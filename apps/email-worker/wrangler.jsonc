{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "private-profile-email",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  // Mail arrives only through Email Routing, so there is no public HTTP URL.
  "workers_dev": false,
  "preview_urls": false,
  "kv_namespaces": [
    {
      // Value format: docs/kv-address-list.md
      "binding": "PROFILE_ADDRESSES",
      // Stays a placeholder in git (ADR 0004). scripts/worker-config.sh
      // writes wrangler.local.jsonc with KV_NAMESPACE_ID from deploy/admin.env.
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "vars": {
    "SYSTEM_ADDRESSES": "postmaster,abuse"
  }
  // PERSONAL_INBOX is a secret so it never lands in git:
  //   pnpm exec wrangler secret put PERSONAL_INBOX
}
